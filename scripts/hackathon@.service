[Unit]
Description=Spheronix Hackathon FastAPI Instance on Port %i
After=network.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/hack/hackathon registration
EnvironmentFile=/home/ubuntu/hack/hackathon registration/.env
Environment="SERVER_PORT=%i"
Environment="GUNICORN_BIND=127.0.0.1:%i"
ExecStart=/home/ubuntu/hack/hackathon registration/venv/bin/gunicorn -c gunicorn_conf.py app.main:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
