[Unit]
Description=Spheronix Hackathon FastAPI Instance on Port %i
After=network.target

[Service]
Type=simple
User=hackathon
Group=www-data
WorkingDirectory=/opt/hackathon/app
EnvironmentFile=/opt/hackathon/app/.env
Environment="SERVER_PORT=%i"
Environment="GUNICORN_BIND=127.0.0.1:%i"
ExecStart=/opt/hackathon/app/venv/bin/gunicorn -c gunicorn_conf.py app.main:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
