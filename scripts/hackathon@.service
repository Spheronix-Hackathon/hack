[Unit]
Description=Spheronix Hackathon FastAPI Instance on Port %i
After=network.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/hack/hackathon registration
ExecStart=/bin/bash "/home/ubuntu/hack/hackathon registration/scripts/run_instance.sh" %i
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
